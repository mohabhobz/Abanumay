{
  "name": "abanumay-grants",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "نظام منح مؤسسة سليمان أبانمي الأهلية — بروتوتايب الواجهة",
  "scripts": {
    "dev": "vite",
    "build": "node tools/cssbalance.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "audit": "node tools/audit.mjs",
    "audit:full": "node tools/audit.mjs --full",
    "audit:lock": "node tools/audit.mjs --lock",
    "css:balance": "node tools/cssbalance.mjs",
    "clean": "rm -rf dist",
    "audit:fast": "node tools/cssbalance.mjs && node tools/audit.mjs && node tools/ctlaudit.mjs",
    "routes:cover": "node tools/routecover.mjs",
    "links": "node tools/linkaudit.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true",
    "sweep": "node tools/sweep.mjs",
    "check": "node tools/pathsafe.mjs && node tools/cssbalance.mjs && npm run --silent typecheck && npm run --silent lint && node tools/audit.mjs && node tools/emdash.mjs && node tools/hacts.mjs && node tools/noselect.mjs && node tools/routemount.mjs && node tools/routecover.mjs",
    "check:all": "npm run --silent build && npm run --silent check && node tools/sweep.mjs --themes"
  },
  "dependencies": {
    "lucide-react": "^1.44.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.11"
  }
}