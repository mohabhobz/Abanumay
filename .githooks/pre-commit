#!/bin/sh
# ═══════════════════════════════════════════════════════════
#  بوّابة الكوميت.
#
#  ⚠️ الجملة «البوّابة بتوقف الكوميت لو رقم طلع» كانت مكتوبة في
#  CLAUDE.md من ١٢ سبتمبر **وهي مش صحيحة**: .git/hooks كانت فاضية،
#  ومفيش husky، ومفيش سطر في package.json. يعني الحراسة كلها كانت
#  بالنيّة · اللي يفتكر يشغّل `npm run audit` بيشغّله.
#
#  الملف ده متتبَّع في الريبو (`core.hooksPath=.githooks`) عشان أي
#  نسخة أو أي جلسة تشتغل تحت نفس الحراسة، مش بس الجهاز اللي اتظبط.
#
#  الستة دول ساكنين وسريعين (~١٥ ثانية). الفحوص المرسومة
#  (المتصفّح) أبطأ من إنها تقعد هنا · مكانها قبل ما تقفل جولة شكل،
#  والقايمة في CLAUDE.md.
#
#  للطوارئ: git commit --no-verify
# ═══════════════════════════════════════════════════════════
set -e

printf '\n  ── بوّابة الكوميت ──\n'

node tools/pathsafe.mjs          # `.pathname` بيكوّد المسافات · أداة بتطيح على جهاز وتعدّي على جهاز
node tools/cssbalance.mjs        # تعليق ناقص بيوقع البِناء ويخلّي الجرد يشتغل على dist قديم
node tools/routecover.mjs        # شاشة جديدة بلا مسار مفحوص = كل الأدوات بترجع خضرا وهي عمياها
node tools/routemount.mjs        # مسار معلَن بلا شاشة · الزرار موجود والشاشة لأ (١٨ سبتمبر)
node tools/emdash.mjs            # الشرطة الطويلة · قاعدة كانت مكتوبة وما كانش عليها فحص
node tools/hacts.mjs             # عقد أفعال الترويسة · الإنشاء في الركن لا في شريط الأدوات
node tools/noselect.mjs          # `<select>` و`type="date"` الأصليين · وعنوان فوق قائمة
node tools/onemenu.mjs           # لوحة القائمة مرسومة في مكان واحد · مش منسوخة ست مرّات
npm run --silent typecheck
npm run --silent lint
node tools/audit.mjs             # العدّادات · الرقم ينزل أو يثبت وما يطلعش
# ⚠️ الفحص البصري **مش هنا** عن قصد: بياخد ٣ دقايق ومحتاج بِناء،
#    والبوّابة لازم تفضل تحت العشرين ثانية وإلا الناس بتعمل
#    `--no-verify`. مكانه `npm run check:all` قبل البوش.

printf '  ✅ عدّت\n\n'
