#!/bin/sh
# ═══════════════════════════════════════════════════════════
#  بوّابة الكوميت.
#
#  ⚠️ الجملة «البوّابة بتوقف الكوميت لو رقم طلع» كانت مكتوبة في
#  CLAUDE.md من ١٢ سبتمبر **وهي مش صحيحة**: .git/hooks كانت فاضية،
#  ومفيش husky، ومفيش سطر في package.json. يعني الحراسة كلها كانت
#  بالنيّة — اللي يفتكر يشغّل `npm run audit` بيشغّله.
#
#  الملف ده متتبَّع في الريبو (`core.hooksPath=.githooks`) عشان أي
#  نسخة أو أي جلسة تشتغل تحت نفس الحراسة، مش بس الجهاز اللي اتظبط.
#
#  الأربعة دول ساكنين وسريعين (~١٥ ثانية). الفحوص المرسومة
#  (المتصفّح) أبطأ من إنها تقعد هنا — مكانها قبل ما تقفل جولة شكل،
#  والقايمة في CLAUDE.md.
#
#  للطوارئ: git commit --no-verify
# ═══════════════════════════════════════════════════════════
set -e

printf '\n  ── بوّابة الكوميت ──\n'

node tools/cssbalance.mjs        # تعليق ناقص بيوقع البِناء ويخلّي الجرد يشتغل على dist قديم
node tools/routecover.mjs        # شاشة جديدة بلا مسار مفحوص = كل الأدوات بترجع خضرا وهي عمياها
npm run --silent typecheck
npm run --silent lint
node tools/audit.mjs             # العدّادات · الرقم ينزل أو يثبت وما يطلعش

printf '  ✅ عدّت\n\n'
